# Production Environment Variables for STREETCREED
# Copy this to .env.production or set in Netlify Dashboard (Site settings > Environment variables)
# NEVER commit real secrets to version control.

# Database (PostgreSQL) - REQUIRED for auth and orders
# Get from your PostgreSQL provider (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# Site URL - REQUIRED for canonical URLs, sitemap, auth callbacks
# Set to your Netlify URL (e.g., https://streetcreed.netlify.app) or custom domain
NEXT_PUBLIC_SITE_URL="https://streetcreed.netlify.app"

# Auth Secret - REQUIRED for login/sessions (min 32 chars)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Stripe (optional - for real payments)
# STRIPE_SECRET_KEY=""              # Server-only, never expose to client
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""  # Client-safe

# Optional: Analytics, monitoring, etc.
# NEXT_PUBLIC_GA_ID=""
# SENTRY_DSN=""